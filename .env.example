# Usado pelo docker-compose (gere com: openssl rand -hex 32)
JWT_SECRET=
# Chave que criptografa o segredo do 2FA no banco (gere com: openssl rand -hex 32)
TOTP_ENCRYPTION_KEY=

# Opcionais: IDs públicos do Google Analytics 4 e do Microsoft Clarity (vão para o JavaScript do site).
# Vazios = sem analytics e sem aviso de cookies.
VITE_GA_ID=
VITE_CLARITY_ID=
